def twoStacks(maxSum, a, b):
    total_sum = 0
    count = 0
    n = len(a)
    m = len(b)
    
    while count < n and total_sum + a[count] <= maxSum:
        total_sum += a[count]
        count += 1
    
    max_count = count  
    for i in range(m):
        total_sum += b[i]
        
        while total_sum > maxSum and count > 0:
            count -= 1
            total_sum -= a[count]
        
        if total_sum <= maxSum:
            max_count = max(max_count, count + i + 1)
    
    return max_count

if __name__ == '__main__':
    games = int(input().strip())  
    for _ in range(games):
        n, m, maxSum = map(int, input().strip().split()) 
        a = list(map(int, input().strip().split()))  
        b = list(map(int, input().strip().split())) 
        result = twoStacks(maxSum, a, b)
        print(result)
